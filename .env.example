# Copy this file to `.env` and fill in the variables you need.
# `scripts/scalerl_smoke.sbatch` sources `.env` from the repo root if it exists.
#
# All variables are OPTIONAL — the smoke runs without any of them, but you'll
# get offline wandb, no HF auth, and the EFA/LD_PRELOAD probes will fall back
# to defaults.

# --- Hugging Face ---
# Required only for gated models. Qwen3-8B (default) is open. Set this if you
# see 429 rate-limits from a shared egress IP, or if you switch to a gated model.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Force offline HF (skip every download). Default: online. The sbatch sets
# HF_HUB_OFFLINE=0 unless your .env explicitly overrides to 1 here.
# HF_HUB_OFFLINE=0

# --- Weights & Biases ---
# Cloud logging. Without WANDB_API_KEY, set WANDB_MODE=offline. The shipped
# configs ship with [wandb] commented out, so wandb is disabled by default —
# uncomment [wandb] in the TOML AND set WANDB_API_KEY here to enable.
# WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WANDB_MODE=online      # or offline

# --- Cluster / network ---
# Set "1" to skip the EFA libfabric env vars when your cluster has no EFA hardware.
# The sbatch already auto-detects /sys/class/infiniband and skips when nothing
# matches `^efa`. Set this to FORCE-skip even when the probe says EFA is present
# (e.g. driver mismatch, hangs at NCCL init).
# SCALERL_NO_EFA=1

# Set "1" to clear LD_LIBRARY_PATH / LD_PRELOAD even on non-AWS-DLAMI hosts.
# Useful when your cluster ships an LD_PRELOAD-shimmed cuBLAS that conflicts
# with the wheel-bundled cuBLAS in `prime-rl`'s torch.
# SCALERL_FORCE_CLEAR_LD=1

# --- Optional API keys for judges / external evals ---
# Only needed if your config references an LLM judge (e.g. Anthropic / OpenAI
# rubric scoring). The math/terminal-bench shipped configs do not.
# OPENAI_API_KEY=sk-xxxx
# ANTHROPIC_API_KEY=sk-ant-xxxx
